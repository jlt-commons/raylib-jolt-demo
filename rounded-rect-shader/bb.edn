;; Run this demo from here with `bb run` or `jolt run`. From the repo root it's
;; `bb rounded-rect-shader`. Written by `bb resync` when missing; edits survive.
{:tasks
 {:requires ([babashka.fs :as fs])
  :init (def jolt-cmd (if (fs/which "jolt") "jolt" "joltc"))
  run {:doc "▶ SDF rounded rects: fill, border, shadow"
       :override-builtin true
       :task (let [{:keys [exit]} (shell {:continue true} jolt-cmd "-M:run")]
               (when-not (zero? exit) (System/exit exit)))}}}
