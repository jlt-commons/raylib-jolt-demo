# jolt's classpath cache, created by any `jolt -M:<alias>` run (root or demo)
.jolt/

# smoke-test screenshots (RAYLIB_APP_SHOT) and mouse-painting's save
shot*.png
raylib_shot.png
my_painting.png

# storage-values writes here, in whatever directory it was run from
storage.edn

.remember/
.DS_Store

# docs-engine build output and a local engine checkout
_site/
.docs-engine/

# clj-kondo analysis cache (the config and hook next to it are tracked)
.clj-kondo/.cache/

# Clojure CLI classpath cache (created when a tool resolves a deps.edn with the clojure CLI)
.cpcache/

# screen-grab teardown markers (out-dir scratch; recover-pending! executes these)
docs/demos/.screen-grab-pending.edn*
