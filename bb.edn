;; Task runner for raylib-jolt-demo: 187 raylib examples in jolt, one sub-project each.
;;
;; Run these from the repo root with EITHER `bb <task>` or `jolt <task>`. jolt
;; reads this file as well as deps.edn, so both runners see the same tasks.
;;
;;   bb info               grouped cheat-sheet, every demo included
;;   bb <demo>             run one demo, e.g. bb asteroids
;;   bb run <demo>         the same, by argument; raylib-jlt's old names work too
;;   bb list               flat list of demos with descriptions
;;   bb run-all [secs]     every demo for N seconds each (default 2), unattended
;;   bb check              compile every demo, no window
;;   bb doctor             is jolt there, does raylib-jlt resolve, is libraylib installed?
;;   bb gen [--check]      rebuild deps.edn, check.clj, these tasks and the gallery
;;
;; Demos run through the root deps.edn alias, from this directory, exactly as
;; `jolt -M:<alias>` does. The demo list is demos.edn, edited by hand, and the
;; per-demo tasks at the bottom are written from it by `bb gen`.
;;
;; NOTE: task bodies are EDN-parsed. No #"regex", no @deref, no #(...).
{:min-bb-version "1.3.0"
 :paths ["scripts"]
 :tasks
 {:requires ([babashka.fs :as fs]
             [clojure.edn :as edn]
             [clojure.string :as str])

  :init
  (do
    ;; bb sets babashka.version, jolt sets jolt.version.
    (def runner (if (System/getProperty "babashka.version") "bb" "jolt"))
    (def jolt-cmd (if (fs/which "jolt") "jolt" "joltc"))

    ;; [{:name :alias :category :desc :old-name?} ...], edited by hand.
    (def demos (if (fs/exists? "demos.edn") (edn/read-string (slurp "demos.edn")) []))

    (defn find-demo [s]
      (first (filter (fn [d] (some (fn [k] (= s (get d k))) [:name :alias :old-name])) demos)))

    (defn run-demo
      "Run one demo through its root alias. Extra env, e.g. RAYLIB_APP_AUTO_QUIT_MS,
      goes to the child."
      ([name] (run-demo name {}))
      ([name env]
       (let [d (find-demo name)]
         (when-not d
           (binding [*out* *err*]
             (println (str "No demo named " name ". `" runner " list` shows them all.")))
           (System/exit 1))
         (shell {:continue true :extra-env env} jolt-cmd (str "-M:" (:alias d))))))

    (defn exit-with [{:keys [exit]}]
      (when-not (zero? exit) (System/exit exit))))

  info
  {:doc "Grouped cheat-sheet, every demo included (start here)"
   :task
   (let [esc (str (char 27) "[")
         col (fn [c s] (str esc c "m" s esc "0m"))
         hdr (fn [s] (println (str "\n" (col "35" (str "── " s " ──")))))
         row (fn [t d] (println (str "  " (col "36" (format "%-32s" (str runner " " t))) d)))]
     (println (col "1;35" "\nraylib-jolt-demo: 187 raylib examples in jolt, one sub-project each"))
     (println (col "2" (str "  runner: " runner "   ·   both `bb <task>` and `jolt <task>` work")))
     (hdr "Run")
     (row "<demo>" "run one demo, e.g. asteroids")
     (row "run <demo>" "the same, by argument; raylib-jlt's old names work too")
     (row "list" "flat list of demos with descriptions")
     (row "run-all [secs]" "every demo for N seconds each (default 2), unattended")
     (hdr "Verify")
     (row "doctor" "check jolt, the raylib-jlt dependency and libraylib")
     (row "check" "compile every demo, no window")
     (hdr "Maintenance")
     (row "gen [--check]" "rebuild deps.edn, check.clj, demo tasks and gallery from demos.edn")
     (doseq [[category ds] (sort-by key (group-by :category demos))]
       (hdr (str (or category "local") " (" (count ds) ")"))
       (doseq [d ds] (row (:name d) (or (:desc d) ""))))
     (println (str "\n" (col "2" (str "first run: " runner " doctor, then " runner " asteroids")))))}

  list
  {:doc "Flat list of demos with descriptions"
   :task (let [w (apply max (map (fn [d] (count (:name d))) demos))]
           (doseq [d demos]
             (println (format (str "%-" w "s  %-10s  %s") (:name d) (or (:category d) "local") (or (:desc d) "")))))}

  run
  {:doc "Run one demo by name: run <demo>"
   :override-builtin true
   :task (if-let [name (first *command-line-args*)]
           (exit-with (run-demo name))
           (do (println (str "usage: " runner " run <demo>   (" runner " list shows them)"))
               (System/exit 1)))}

  run-all
  {:doc "Every demo for N seconds each (default 2), unattended; exits 1 if any fail"
   :task (let [secs (Long/parseLong (or (first *command-line-args*) "2"))
               failed (vec (for [d demos
                                 :let [_ (println (str "▶ " (:name d)))
                                       {:keys [exit]} (run-demo (:name d) {"RAYLIB_APP_AUTO_QUIT_MS" (str (* 1000 secs))})]
                                 :when (not (zero? exit))]
                             (str (:name d) " (exit " exit ")")))]
           (println (str "\n" (- (count demos) (count failed)) "/" (count demos) " demos exited cleanly"))
           (when (seq failed)
             (println (str "failed: " (str/join ", " failed)))
             (System/exit 1)))}

  check
  {:doc "Compile every demo, no window"
   :task (exit-with (shell {:continue true} jolt-cmd "-M:check"))}

  doctor
  {:doc "Check jolt, the raylib-jlt dependency and libraylib before anything else"
   :task (let [lib-paths (if (str/includes? (str/lower-case (System/getProperty "os.name")) "mac")
                           ["/opt/homebrew/lib/libraylib.dylib" "/usr/local/lib/libraylib.dylib"]
                           ["/usr/lib/libraylib.so" "/usr/local/lib/libraylib.so"
                            "/usr/lib/x86_64-linux-gnu/libraylib.so" "/usr/lib/aarch64-linux-gnu/libraylib.so"])
               checks [["jolt on PATH" (fs/which jolt-cmd) "install jolt: https://github.com/jolt-lang/jolt"]
                       ;; Resolving the classpath fetches the pinned raylib-jlt the
                       ;; first time, so this also proves the network can reach it.
                       ["raylib-jlt (the bindings, pinned in common/deps.edn)"
                        (and (fs/which jolt-cmd)
                             (str/includes? (:out (shell {:out :string :err :string :continue true} jolt-cmd "-Spath"))
                                            "raylib-jlt"))
                        "check network access to github.com, then common/deps.edn's :git/sha"]
                       ["libraylib" (some fs/exists? lib-paths)
                        "brew install raylib, or your distro's raylib package (6.0+)"]
                       ["demos.edn" (fs/exists? "demos.edn") "restore it from git"]]]
           (doseq [[what ok fix] checks]
             (println (str (if ok "  ok    " "  MISSING ") what (when-not ok (str "  -> " fix)))))
           (when-not (every? second checks) (System/exit 1)))}

  gen
  {:doc "Rebuild deps.edn, check.clj, demo tasks and gallery from demos.edn: gen [--check]"
   :requires ([gen])
   :task (apply gen/-main *command-line-args*)}

